NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000
API_URL=http://localhost:4000
PLAYER_URL=http://localhost:3000
MEDIA_URL=http://localhost:8787

DATABASE_URL=postgresql://video:video@localhost:5432/video
DIRECT_DATABASE_URL=postgresql://video:video@localhost:5432/video

REDIS_URL=redis://localhost:6379

SESSION_COOKIE_NAME=video_session
SESSION_TTL_SECONDS=3600
SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_SECRET=replace-with-at-least-32-random-characters

CSRF_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SALT=replace-with-private-random-salt
TRUST_PROXY=false
ENABLE_API_DOCS=false

BOOTSTRAP_SYSTEM_EMAIL=system@example.com
BOOTSTRAP_SYSTEM_PASSWORD=1234
BOOTSTRAP_SYSTEM_NAME=ผู้ดูแลระบบ

STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=videos
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=

MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters
MEDIA_URL_TTL_SECONDS=600
UPLOAD_MAX_FILE_BYTES=10737418240
UPLOAD_PART_SIZE_BYTES=16777216
UPLOAD_URL_TTL_SECONDS=900
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_MAX_CONCURRENT_FILES=20
UPLOAD_MAX_CONCURRENT_PARTS=20
MEDIA_TRANSCODE_MODE=auto
MEDIA_VIDEO_CRF=23
MEDIA_VIDEO_PRESET=medium
MEDIA_AUDIO_BITRATE=128k
MEDIA_MAX_WIDTH=1920
WORKER_TMP_DIR=/tmp/video-worker

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ANALYTICS_ENGINE_DATASET=
LOG_LEVEL=info
