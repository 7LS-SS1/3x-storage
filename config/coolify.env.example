APP_URL=https://storage.example.com
ADMIN_URL=https://storage.example.com
PLAYER_URL=https://storage.example.com
MEDIA_URL=https://media.example.com

# Copy the internal URL from a PostgreSQL 17 resource in Coolify.
# URL-encode the password and keep the connection pool deliberately small.
DATABASE_URL=postgresql://video:URL_ENCODED_PASSWORD@postgres-COOLIFY_UUID:5432/video?schema=public&connection_limit=5&pool_timeout=20&connect_timeout=10
DIRECT_DATABASE_URL=postgresql://video:URL_ENCODED_PASSWORD@postgres-COOLIFY_UUID:5432/video?schema=public&connect_timeout=10

REDIS_PASSWORD=replace-with-a-strong-random-password

SESSION_COOKIE_NAME=__Host-video_session
SESSION_TTL_SECONDS=3600
SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_SECRET=replace-with-random-256-bit-secret
CSRF_SECRET=replace-with-a-different-random-256-bit-secret
IP_HASH_SALT=replace-with-a-different-random-256-bit-secret
MEDIA_SIGNING_SECRET=replace-with-the-same-secret-used-by-the-media-worker

R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=3xapi
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=replace-with-bucket-scoped-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-bucket-scoped-r2-secret-access-key
STORAGE_CAPACITY_BYTES=

MEDIA_URL_TTL_SECONDS=600
UPLOAD_MAX_FILE_BYTES=10737418240
UPLOAD_MULTIPART_THRESHOLD_BYTES=104857600
UPLOAD_PART_SIZE_BYTES=67108864
UPLOAD_URL_TTL_SECONDS=900
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_MAX_CONCURRENT_FILES=3
UPLOAD_MAX_CONCURRENT_PARTS=4

DRIVE_IMPORT_CONCURRENCY=2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://storage.example.com/backend/google-drive/callback
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-random-256-bit-secret

MEDIA_TRANSCODE_MODE=auto
MEDIA_VIDEO_CRF=23
MEDIA_VIDEO_PRESET=medium
MEDIA_AUDIO_BITRATE=128k
MEDIA_MAX_WIDTH=1920

# Set these only for the first deployment, then remove them from Coolify.
BOOTSTRAP_SYSTEM_EMAIL=
BOOTSTRAP_SYSTEM_NAME=
BOOTSTRAP_SYSTEM_PASSWORD=
