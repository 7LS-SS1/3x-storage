{
  "name": "@video/database",
  "private": true,
  "files": ["prisma", "package.json"],
  "scripts": {
    "build": "node --env-file=../../.env node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "lint": "node --env-file=../../.env node_modules/prisma/build/index.js validate --schema prisma/schema.prisma",
    "typecheck": "node --env-file=../../.env node_modules/prisma/build/index.js validate --schema prisma/schema.prisma",
    "test": "vitest run --passWithNoTests",
    "db:generate": "node --env-file=../../.env node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "db:migrate": "node --env-file=../../.env node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": { "@prisma/client": "^6.13.0", "argon2": "^0.41.1" },
  "devDependencies": { "@types/node": "^22.14.0", "prisma": "^6.13.0", "tsx": "^4.20.0", "vitest": "^3.2.4" }
}
